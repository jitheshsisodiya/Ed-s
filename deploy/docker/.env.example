# --- Postgres ---
POSTGRES_USER=nexusvpn
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=nexusvpn
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_HTTP_PORT=8080
BACKEND_GRPC_PORT=9090
BACKEND_METRICS_PORT=9091
JWT_ACCESS_SECRET=change-me-32-byte-minimum-secret-access
JWT_REFRESH_SECRET=change-me-32-byte-minimum-secret-refresh
# Shared between the backend and every relay node: it authenticates relay
# registration and signs/verifies the session tokens clients present.
JWT_RELAY_SECRET=change-me-32-byte-minimum-secret-relay
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback
CORS_ORIGINS=*
ENVIRONMENT=development
LOG_LEVEL=info

# --- Relay ---
RELAY_CONTROL_PORT=3478
RELAY_DATA_PORT=3479
RELAY_METRICS_PORT=9092
RELAY_REGION=local
RELAY_PUBLIC_HOSTNAME=localhost
RELAY_CAPACITY=1000

# --- Admin panel ---
ADMIN_HTTP_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Monitoring ---
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_PORT=9095
