# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# Machine-specific generated files: these contain absolute SDK paths and are
# regenerated by `flutter pub get`, so committing them breaks other machines.
android/local.properties
android/.gradle/
android/.kotlin/
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Runner/GeneratedPluginRegistrant.*
ios/Pods/
ios/.symlinks/

# Release signing. The keystore and its password are per-publisher secrets:
# whoever holds them can ship an update that Android accepts as this app.
# They never belong in a repository. See README.md "Building a release APK".
android/key.properties
*.jks
*.keystore
