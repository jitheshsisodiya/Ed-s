<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown from launch until Flutter draws its first frame. It carries the
         deck's own ground colour so there is no flash of white before the app
         appears. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once Flutter is running, so the system draws normally behind
         a Dart-rendered UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
