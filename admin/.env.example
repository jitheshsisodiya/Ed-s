# Base URL of the NexusVPN REST API (see api/openapi.yaml). Must include the
# /api/v1 prefix. In production this is usually proxied through nginx at
# the same origin as the admin panel (see nginx.conf.template + Dockerfile),
# in which case you can set this to a relative path like "/api/v1".
VITE_API_BASE_URL=http://localhost:8080/api/v1
