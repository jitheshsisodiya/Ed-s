# Only send "Connection: upgrade" upstream when the client actually
# requested an upgrade; ordinary requests must keep the connection intact.
# This file is rendered into conf.d/, which nginx includes inside http{},
# so a map here is at the correct level.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Don't advertise the exact nginx version to attackers.
    server_tokens off;

    include /etc/nginx/security-headers.conf;

    # Gzip static assets.
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;

    # SPA: let react-router handle client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache hashed build assets aggressively; never cache index.html.
    # nginx drops inherited add_header directives in any block that declares
    # its own, so the security headers are re-included here and below.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Reverse proxy API calls to the backend control plane so the SPA can be
    # configured with VITE_API_BASE_URL=/api/v1 (same-origin, no CORS
    # needed). ${API_UPSTREAM} is substituted from the environment at
    # container start via envsubst (see Dockerfile CMD).
    location /api/ {
        include /etc/nginx/security-headers.conf;

        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for /api/v1/ws signaling. Only upgrade when the
        # client actually asked to: sending "Connection: upgrade" on ordinary
        # requests confuses some upstreams and proxies.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Long-lived streams (WebSocket) must not be cut by a read timeout.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
